---
import { Image } from "astro:assets";
import { markdownify } from "@/lib/utils/textConverter";
const { title, content, button, image } = Astro.props;
---

<!-- banner -->
<section class="section pb-[50px]">
  <div class="container">
    <div class="row text-center">
      <div class="mx-auto lg:col-10">
        <h1 class="font-primary font-bold">{title}</h1>
        {content && <p class="mt-4" set:html={markdownify(content)} />}

        {
          button?.enable && (
            <a class="btn btn-primary mt-4" href={button.link}>
              {button.label}
            </a>
          )
        }

        {
          image && (
            <Image
              class="mx-auto mt-12"
              src={image}
              width={750}
              height={390}
              alt="banner image"
            />
          )
        }
      </div>
    </div>
  </div>
</section>
